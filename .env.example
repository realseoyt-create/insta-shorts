# ── 필수: 대본 작성 (무료) ── https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── 트렌드 수집 (둘 중 하나 이상. 없으면 관리 화면에서 직접 소재 추가) ──
# 유튜브 인기 쇼츠 (무료) — Google Cloud 콘솔에서 YouTube Data API v3 키 발급
YOUTUBE_API_KEY=
# 인스타 해시태그 인기 게시물 (Apify, 무료 크레딧 초과 시 과금)
APIFY_TOKEN=

# ── 선택: 배경 스톡 영상 (무료, 둘 중 하나) ── https://pixabay.com/api/docs/ 또는 https://www.pexels.com/api/
PIXABAY_API_KEY=
PEXELS_API_KEY=

# ── 발행 ──
# Cloudinary (무료): 영상에 공개 주소를 붙이는 용도. 서명 없는(unsigned) 업로드 프리셋 이름
CLOUDINARY_CLOUD=
CLOUDINARY_PRESET=
# 인스타그램 비즈니스 계정 ID와 접속 토큰 (Meta 개발자 앱에서 발급)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_HANDLE=@sebaggul

# ── 프로필 링크 페이지 (GitHub Pages, 무료) ──
# 공개 저장소 이름(아이디/저장소)과, 그 저장소에만 쓸 수 있는 토큰(Contents·Pages 쓰기 권한)
# 넣으면 사이트를 소개한 게시물을 발행할 때마다 링크 페이지가 자동으로 갱신됩니다
GITHUB_REPO=
GITHUB_TOKEN=

# ── 음성 ── edge(무료, 기본) | google(유료, GOOGLE_TTS_KEY 필요) | none(무음)
TTS_PROVIDER=edge
TTS_VOICE=ko-KR-SunHiNeural
TTS_RATE=+12%

# ── 텔레그램 봇 (검토·승인 알림) ── BotFather에서 받은 토큰
# 넣고 서버를 켜면 관리 화면에 "봇 연결하기" 링크가 뜹니다. 휴대폰에서 열고 "시작"을 누르면 연결됩니다
TELEGRAM_BOT_TOKEN=

# ── 선택: "이번 주 소식" 카드에 쓸 공식 자료 ──
# 공연 예매 순위 (KOPIS 공연예술통합전산망 오픈API) https://www.kopis.or.kr/por/cs/openapi/openApiInfo.do
KOPIS_KEY=
# 축제 정보 (한국관광공사 국문 관광정보 서비스, 공공데이터포털에서 "일반 인증키(Decoding)") https://www.data.go.kr
TOUR_API_KEY=

# ── 선택: 크롬 위치를 자동으로 못 찾을 때만 직접 적음 ──
# 맥 예: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
BROWSER_PATH=

# ── 서버 ──
# 매일 이 시각에 수집 + 새 게시물 제작 → 검토 대기 (비우면 자동 제작 안 함)
SCHEDULE=09:00
# 승인한 게시물을 올리는 시각. 한 번에 하나씩, 승인한 순서대로 (비우면 자동 발행 안 함)
POST_TIMES=12:00,19:00
# 검토 대기 + 발행 예약이 이만큼 쌓여 있으면 자동 제작을 쉼
STOCK_TARGET=8
# 꿀벌 캐릭터 이름
MASCOT_NAME=바꿀이
# 제휴 링크(쿠팡 파트너스 등)를 쓰기 시작하면 꿀템 영상 캡션 끝에 붙일 고지 문구
AFFILIATE_NOTICE=
# 매일 "이번 주 소식"(할인·팝업·행사) 카드뉴스를 만들지 (0이면 안 만듦)
DAILY_NEWS=1
# 매일 자동으로 만들 카드뉴스 수 (0이면 안 만듦)
DAILY_CARDS=1
# 카드뉴스 주제를 찾을 인스타 본보기 계정 (토큰에 instagram_manage_insights, pages_read_engagement 권한이 있을 때만 동작)
BENCHMARK_ACCOUNTS=ggul_yang,lady_good_tip
# 직접 촬영 기획을 몇 건까지 미리 만들어 둘지 (0이면 자동 기획 안 함)
SHOOT_PLANS=2
# 비밀번호를 넣으면 외부 접속 허용 + 로그인 필요 (배포할 때 반드시 설정)
ADMIN_PASSWORD=
